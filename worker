function saveMediaAsset(env, uploaded, file, altText) {
  return env.DB.prepare(`
    INSERT INTO media_assets (
      imagekit_file_id,
      image_url,
      thumbnail_url,
      file_name,
      file_path,
      file_type,
      width,
      height,
      file_size,
      alt_text,
      uploaded_by
    )
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  `).bind(
    uploaded.fileId,
    uploaded.url,
    uploaded.thumbnailUrl || null,
    uploaded.name,
    uploaded.filePath || null,
    "image",
    uploaded.width || null,
    uploaded.height || null,
    uploaded.size || file.size,
    String(altText || "").slice(0, 500),
    ADMIN_EMAIL
  ).run().then(result => result.meta.last_row_id);
}
async function addToCollection(env, mediaId, collectionSlug) {
  const collection = COLLECTIONS.find(
    item => item.slug === collectionSlug
  );
  if (!collection) {
    throw new Error("Invalid portfolio collection");
  }
  const collectionRecord = await env.DB.prepare(`
    SELECT id FROM portfolio_collections WHERE slug = ?
  `).bind(collection.slug).first();
  if (!collectionRecord) {
    throw new Error(
      `Collection "${collection.name}" was not found in the database`
    );
  }
  const order = await env.DB.prepare(`
    SELECT COALESCE(MAX(display_order), 0) + 1 AS next_order
    FROM portfolio_items
    WHERE collection_id = ?
  `).bind(collectionRecord.id).first();
  await env.DB.prepare(`
    INSERT INTO portfolio_items (
      collection_id,
      media_id,
      display_order
    )
    VALUES (?, ?, ?)
  `).bind(
    collectionRecord.id,
    mediaId,
    order.next_order
  ).run();
  return collection;
}
async function addToPlacement(env, mediaId, placementType, details) {
  const order = await env.DB.prepare(`
    SELECT COALESCE(MAX(display_order), 0) + 1 AS next_order
    FROM site_media_placements
    WHERE placement_type = ?
  `).bind(placementType).first();
  await env.DB.prepare(`
    INSERT INTO site_media_placements (
      placement_type,
      media_id,
      title,
      subtitle,
      link_url,
      display_order,
      is_visible
    )
    VALUES (?, ?, ?, ?, ?, ?, 1)
  `).bind(
    placementType,
    mediaId,
    details.title || null,
    details.subtitle || null,
    details.link_url || null,
    order.next_order
  ).run();
}

