          const contrast=clamp(body.contrast,50,150,100), saturation=clamp(body.saturation,0,200,100);
          const rotation=((Math.round(clamp(body.rotation,-270,270,0))%360)+360)%360;
          const aspect_ratio = ["original","1 / 1","4 / 5","16 / 9"].includes(body.aspect_ratio) ? body.aspect_ratio : "original";
