async function syncClientFromBooking(env, booking) {
  const name = String(booking.customer_name || "").trim().slice(0, 200);
  const email = String(booking.email || "").trim().toLowerCase().slice(0, 254);
  const phone = typeof booking.phone === "string" ? booking.phone.trim().slice(0, 50) : "";
  if (!name || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) return;

  const existing = await env.DB.prepare(
    "SELECT id FROM clients WHERE email = ? COLLATE NOCASE ORDER BY id ASC LIMIT 1"
  ).bind(email).first();

  if (existing) {
    // Keep manually maintained profile details; only fill a missing phone number.
    if (phone) {
      await env.DB.prepare(`
        UPDATE clients
        SET phone = ?, updated_at = CURRENT_TIMESTAMP
        WHERE id = ? AND (phone IS NULL OR trim(phone) = '')
      `).bind(phone, existing.id).run();
    }
    return;
  }

  await env.DB.prepare(`
    INSERT INTO clients (full_name, email, phone, notes)
    SELECT ?, ?, ?, NULL
    WHERE NOT EXISTS (
      SELECT 1 FROM clients WHERE email = ? COLLATE NOCASE
    )
  `).bind(name, email, phone || null, email).run();
}

