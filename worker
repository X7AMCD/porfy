        if (!email || !password || email.length > 254 || password.length > 200) {
          return json({ error: "That username or password isn’t right." }, 401, origin);
        }
        const client = await env.DB.prepare(
          "SELECT id, full_name, email FROM clients WHERE lower(email) = ? LIMIT 1"
        ).bind(email).first();
        if (!client) return json({ error: "That username or password isn’t right." }, 401, origin);
        const matches = await env.DB.prepare(`
          SELECT id, title, is_active, expires_at, access_code_hash
          FROM client_galleries WHERE client_id = ?
          ORDER BY created_at DESC, id DESC
        `).bind(client.id).all();
        const toHex = bytes => Array.from(new Uint8Array(bytes), byte => byte.toString(16).padStart(2, "0")).join("");
        let matchedGallery = null;
        for (const gallery of matches.results || []) {
          if (!gallery.is_active) continue;
          if (gallery.expires_at && Date.parse(gallery.expires_at) < Date.now()) continue;
          const parts = String(gallery.access_code_hash || "").split("$");
          if (parts.length !== 4 || parts[0] !== "pbkdf2-sha256") continue;
          const iterations = Number(parts[1]);
          if (!Number.isSafeInteger(iterations) || iterations < 10000 || iterations > 1000000 || !/^[a-f0-9]{32}$/i.test(parts[2]) || !/^[a-f0-9]{64}$/i.test(parts[3])) continue;
          try {
            const salt = new Uint8Array(parts[2].match(/.{2}/g).map(x => parseInt(x, 16)));
            const key = await crypto.subtle.importKey("raw", new TextEncoder().encode(password), "PBKDF2", false, ["deriveBits"]);
            const derived = await crypto.subtle.deriveBits(
              { name: "PBKDF2", salt, iterations, hash: "SHA-256" }, key, 256
            );
            if (toHex(derived) === parts[3]) { matchedGallery = gallery; break; }
          } catch (verifyError) {
            console.error("Gallery password verification failed:", verifyError);
          }
