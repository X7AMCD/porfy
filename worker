      // -----------------------------------------------
      if (
        url.pathname === "/admin/website-images" &&
        request.method === "GET"
      ) {
        try {
          const pages = [
            { url: "https://x7studios.co.za/", label: "Homepage" },
            { url: "https://x7studios.co.za/preview", label: "Portfolio website" }
          ];

          const collectionMap = {
            images11: { name: "Portraits", slug: "portraits" },
            images12: { name: "Street & Urban", slug: "street-urban" },
            images13: { name: "Lifestyle", slug: "lifestyle" },
            images14: { name: "Brand & Product", slug: "brand-product" },
            images15: { name: "Events", slug: "events" },
            images16: { name: "Nature", slug: "nature" }
          };

          const discovered = new Map();
          const scannedPages = [];

          for (const page of pages) {
            const response = await fetch(page.url);
            if (!response.ok) {
              console.warn("Website image scan skipped", page.url, response.status);
              continue;
            }

            const html = await response.text();
            scannedPages.push(page.label);

            const pattern = /https:\/\/ik\.imagekit\.io\/amcid\/[^\s"'\x60<>\\)]+/g;

            for (const match of html.matchAll(pattern)) {
              const sourceUrl = match[0].replace(/[),;]+$/, "");
              let parsedUrl;

              try {
                parsedUrl = new URL(sourceUrl);
              } catch {
                continue;
              }

              if (
                parsedUrl.hostname !== "ik.imagekit.io" ||
                !parsedUrl.pathname.startsWith("/amcid/")
              ) continue;

              // Ignore transformation/query-string differences when identifying the same file.
              const uniqueKey = parsedUrl.origin + parsedUrl.pathname;
              const pathParts = parsedUrl.pathname.split("/").filter(Boolean);
              const folder = (pathParts[pathParts.length - 2] || "").toLowerCase();
              const collection = collectionMap[folder];

              let fileName = pathParts[pathParts.length - 1] || "Image";
              try {
                fileName = decodeURIComponent(fileName);
              } catch {
                // Retain the original filename if decoding fails.
              }

              if (discovered.has(uniqueKey)) {
                const existing = discovered.get(uniqueKey);
                if (!existing.source_pages.includes(page.label)) {
                  existing.source_pages.push(page.label);
                }
                continue;
              }

              discovered.set(uniqueKey, {
                url: sourceUrl,
                file_name: fileName,
                section: collection ? collection.name : "Homepage / Hero",
                collection_name: collection ? collection.name : null,
                collection_slug: collection ? collection.slug : null,
                source: "live_website",
                source_pages: [page.label]
              });
            }
          }

          // Include images published through the database-backed portfolio API.
          // These URLs are added to the live collections after the HTML is loaded,
          // so they cannot be discovered by scanning page source alone.
          try {
            const portfolioResponse = await fetch("https://api.x7studios.co.za/portfolio");
            if (portfolioResponse.ok) {
              const portfolioData = await portfolioResponse.json();
              const portfolioItems = Array.isArray(portfolioData.portfolio)
                ? portfolioData.portfolio
                : [];

              for (const item of portfolioItems) {
                const sourceUrl = item.image_url;
                if (typeof sourceUrl !== "string") continue;

                let parsedUrl;
                try {
                  parsedUrl = new URL(sourceUrl);
                } catch {
                  continue;
                }

                if (
                  parsedUrl.hostname !== "ik.imagekit.io" ||
                  !parsedUrl.pathname.startsWith("/amcid/")
                ) continue;

                const uniqueKey = parsedUrl.origin + parsedUrl.pathname;
                const slug = String(item.collection_slug || "").toLowerCase();
                const collectionMapBySlug = {
                  portraits: "Portraits",
                  "street-urban": "Street & Urban",
                  lifestyle: "Lifestyle",
                  "brand-product": "Brand & Product",
                  events: "Events",
                  nature: "Nature"
                };
                const collectionName = collectionMapBySlug[slug] || item.collection_name || null;
                const pathParts = parsedUrl.pathname.split("/").filter(Boolean);
                let fileName = pathParts[pathParts.length - 1] || "Image";
                try {
                  fileName = decodeURIComponent(fileName);
                } catch {
                  // Keep the original filename if decoding fails.
                }

