          console.error("Portfolio listing failed:", error);
          return json({
            error: "Could not retrieve portfolio"
          }, 500, origin);
        }
      }
      // -----------------------------------------------
      // PORTFOLIO: LIST MEDIA LIBRARY
      // -----------------------------------------------
      if (
        url.pathname === "/admin/media" &&
        request.method === "GET"
      ) {
        try {
          const result = await env.DB.prepare(`
            SELECT * FROM media_assets
            ORDER BY created_at DESC
            LIMIT 500
          `).all();
          return json({
            media: result.results
          }, 200, origin);
        } catch (error) {
          console.error("Media library listing failed:", error);
          return json({
            error: "Could not retrieve media library"
          }, 500, origin);
        }
      }
      // -----------------------------------------------
      // PORTFOLIO: DISCOVER CURRENT WEBSITE IMAGES
      // -----------------------------------------------
      if (
        url.pathname === "/admin/website-images" &&
        request.method === "GET"
      ) {
        try {
          const response = await fetch(
            "https://x7studios.co.za/preview"
          );

          if (!response.ok) {
            throw new Error("Could not read the current website");
          }

          const html = await response.text();

          const start = html.indexOf("const COLLECTIONS = [");
          const end = html.indexOf("];", start);

          if (start === -1 || end === -1) {
            throw new Error("Could not locate the website collections");
          }

          const collectionCode = html.slice(start, end + 2);

          const collectionMap = {
            images11: { name: "Portraits", slug: "portraits" },
            images12: { name: "Street & Urban", slug: "street-urban" },
            images13: { name: "Lifestyle", slug: "lifestyle" },
            images14: { name: "Brand & Product", slug: "brand-product" },
            images15: { name: "Events", slug: "events" },
            images16: { name: "Nature", slug: "nature" }
          };

          const matches = [
            ...collectionCode.matchAll(
              /["']\]?(https:\/\/ik\.imagekit\.io\/amcid\/[^"'\\\s]*)["']/g
            )
          ];

          const seen = new Set();
          const images = [];

          for (const match of matches) {
            const cleanUrl = match[1];

            if (seen.has(cleanUrl)) continue;
            seen.add(cleanUrl);

            let parsedUrl;

            try {
              parsedUrl = new URL(cleanUrl);
            } catch {
              continue;
            }

            const pathParts = parsedUrl.pathname
              .split("/")
              .filter(Boolean);

            const folder = (
              pathParts[pathParts.length - 2] || ""
            ).toLowerCase();

            const collection = collectionMap[folder];

            if (!collection) continue;

            let fileName = pathParts[pathParts.length - 1] || "Image";

            try {
              fileName = decodeURIComponent(fileName);
            } catch {
              // Keep the original filename if decoding fails.
            }

            images.push({
              url: cleanUrl,
              source_url: cleanUrl,
              file_name: fileName,
              collection_name: collection.name,
              collection_slug: collection.slug,
              source: "website"
            });
          }

          return json(
            {
              images,
              total: images.length
            },
            200,
            origin
          );

        } catch (error) {
          console.error("Website image discovery failed:", error);

          return json(
            {
              error: "Could not discover website images"
            },
            500,
            origin
          );
        }
      }
      // -------------------------------------------------
      // SERVICES: LIST
      // -------------------------------------------------
      if (url.pathname === "/admin/services" && request.method === "GET") {
        try {
          const result = await env.DB.prepare(`
            SELECT
              id,
              name,
              slug,
              description,
              base_price AS starting_price,
              currency,
              duration_minutes,
              is_available,
              display_order,
              created_at,
              updated_at
            FROM services
            ORDER BY display_order ASC, id ASC
          `).all();
          const services = await Promise.all(result.results.map(async service => {
            const packages = await env.DB.prepare(`
              SELECT id, service_id, name, description, price, currency,
                     features, is_available, display_order
              FROM service_packages
              WHERE service_id = ?
              ORDER BY display_order ASC, id ASC
            `).bind(service.id).all();
            return { ...service, packages: packages.results };
          }));
          return json({ services }, 200, origin);
        } catch (error) {
          console.error("Service listing failed:", error);
          return json({ error: "Could not retrieve services" }, 500, origin);
        }
      }
      // -------------------------------------------------
      // SERVICES: CREATE
      // -------------------------------------------------
      if (url.pathname === "/admin/services" && request.method === "POST") {
        try {
          const body = await request.json();
          const name = typeof body?.name === "string" ? body.name.trim().slice(0, 150) : "";
          const description = typeof body?.description === "string"
            ? body.description.trim().slice(0, 5000)
            : "";
          const startingPrice = Number(body?.starting_price);
          if (!name) {
            return json({ error: "Service name is required" }, 400, origin);
          }
          if (!Number.isFinite(startingPrice) || startingPrice < 0) {
            return json({ error: "Starting price must be a valid non-negative number" }, 400, origin);
          }
          const baseSlug = name.toLowerCase()
            .normalize("NFKD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/[^a-z0-9]+/g, "-")
            .replace(/^-+|-+$/g, "") || "service";
          let slug = baseSlug;
          let suffix = 2;
          while (await env.DB.prepare("SELECT id FROM services WHERE slug = ?")
            .bind(slug).first()) {
            slug = `${baseSlug}-${suffix++}`;
          }
          const order = await env.DB.prepare(`
            SELECT COALESCE(MAX(display_order), 0) + 1 AS next_order
            FROM services
          `).first();
          const result = await env.DB.prepare(`
            INSERT INTO services (
              name, slug, description, base_price, currency, display_order
            ) VALUES (?, ?, ?, ?, 'ZAR', ?)
          `).bind(name, slug, description || null, startingPrice, order.next_order).run();
          const service = await env.DB.prepare(`
            SELECT id, name, slug, description, base_price AS starting_price,
                   currency, duration_minutes, is_available, display_order,
                   created_at, updated_at
            FROM services WHERE id = ?
          `).bind(result.meta.last_row_id).first();
          return json({ success: true, service: { ...service, packages: [] } }, 201, origin);
        } catch (error) {
          console.error("Service creation failed:", error);
          return json({ error: "Could not create service" }, 500, origin);
        }
      }
      // -------------------------------------------------
      // CLIENTS: LIST
      // -------------------------------------------------
      if (url.pathname === "/admin/clients" && request.method === "GET") {
        try {
          const result = await env.DB.prepare(`
            SELECT id, full_name AS name, email, phone, notes, created_at, updated_at
            FROM clients
            ORDER BY full_name COLLATE NOCASE ASC, id ASC
          `).all();
          return json({ clients: result.results }, 200, origin);
        } catch (error) {
          console.error("Client listing failed:", error);
          return json({ error: "Could not retrieve clients" }, 500, origin);
        }
      }
      // -------------------------------------------------
      // CLIENTS: CREATE
      // -------------------------------------------------
      if (url.pathname === "/admin/clients" && request.method === "POST") {
        try {
          const body = await request.json();
          const name = typeof body?.name === "string" ? body.name.trim().slice(0, 200) : "";
          const email = typeof body?.email === "string" ? body.email.trim().toLowerCase().slice(0, 254) : "";
          const phone = typeof body?.phone === "string" ? body.phone.trim().slice(0, 50) : "";
          const notes = typeof body?.notes === "string" ? body.notes.trim().slice(0, 5000) : "";
          if (!name) return json({ error: "Client name is required" }, 400, origin);
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            return json({ error: "A valid client email address is required" }, 400, origin);
          }
          const existing = await env.DB.prepare(
            "SELECT id FROM clients WHERE email = ? COLLATE NOCASE"
          ).bind(email).first();
          if (existing) return json({ error: "A client with this email already exists" }, 409, origin);
          const result = await env.DB.prepare(`
            INSERT INTO clients (full_name, email, phone, notes)
            VALUES (?, ?, ?, ?)
          `).bind(name, email, phone || null, notes || null).run();
          const client = await env.DB.prepare(`
            SELECT id, full_name AS name, email, phone, notes, created_at, updated_at
            FROM clients WHERE id = ?
          `).bind(result.meta.last_row_id).first();
          return json({ success: true, client }, 201, origin);
        } catch (error) {
          console.error("Client creation failed:", error);
          return json({ error: "Could not create client" }, 500, origin);
        }
      }
      // -------------------------------------------------
      // PRIVATE GALLERIES: LIST
      // -------------------------------------------------
      if (url.pathname === "/admin/galleries" && request.method === "GET") {
        try {
          const result = await env.DB.prepare(`
            SELECT
              g.id, g.client_id, g.title, g.description, g.is_active,
              g.expires_at, g.created_at, g.updated_at,
              c.full_name AS client_name, c.email AS client_email,
              (SELECT COUNT(*) FROM gallery_items gi WHERE gi.gallery_id = g.id) AS item_count
            FROM client_galleries g
            JOIN clients c ON c.id = g.client_id
            ORDER BY g.created_at DESC, g.id DESC
          `).all();
          return json({ galleries: result.results }, 200, origin);
        } catch (error) {
          console.error("Gallery listing failed:", error);
          return json({ error: "Could not retrieve galleries" }, 500, origin);
        }
      }
      // -------------------------------------------------
      // PRIVATE GALLERIES: CREATE
      // -------------------------------------------------
      if (url.pathname === "/admin/galleries" && request.method === "POST") {
        try {
          const body = await request.json();
          const clientId = Number(body?.client_id);
          const title = typeof body?.title === "string" ? body.title.trim().slice(0, 200) : "";
          const expiresAt = typeof body?.expires_at === "string" ? body.expires_at.trim() : "";
          const password = typeof body?.password === "string" ? body.password : "";
          if (!Number.isSafeInteger(clientId) || clientId < 1) {
            return json({ error: "Select a valid client for this gallery" }, 400, origin);
          }
          if (!title) return json({ error: "Gallery title is required" }, 400, origin);
          if (password.length < 6 || password.length > 200) {
            return json({ error: "Gallery password must be between 6 and 200 characters" }, 400, origin);
          }
          if (expiresAt && Number.isNaN(Date.parse(expiresAt))) {
            return json({ error: "Gallery expiry date is invalid" }, 400, origin);
          }
          const client = await env.DB.prepare(
            "SELECT id FROM clients WHERE id = ?"
          ).bind(clientId).first();
          if (!client) return json({ error: "The selected client was not found" }, 404, origin);
          // Store a salted PBKDF2 password hash; never store the password itself.
          const salt = crypto.getRandomValues(new Uint8Array(16));
          const passwordKey = await crypto.subtle.importKey(
            "raw", new TextEncoder().encode(password), "PBKDF2", false, ["deriveBits"]
          );
          const derived = await crypto.subtle.deriveBits(
            { name: "PBKDF2", salt, iterations: 120000, hash: "SHA-256" },
            passwordKey,
            256
          );
          const toHex = bytes => Array.from(new Uint8Array(bytes), byte => byte.toString(16).padStart(2, "0")).join("");
          const accessCodeHash = `pbkdf2-sha256$120000$${toHex(salt)}$${toHex(derived)}`;
          const result = await env.DB.prepare(`
            INSERT INTO client_galleries (
              client_id, title, access_code_hash, expires_at
            ) VALUES (?, ?, ?, ?)
          `).bind(clientId, title, accessCodeHash, expiresAt || null).run();
          const gallery = await env.DB.prepare(`
            SELECT
              g.id, g.client_id, g.title, g.description, g.is_active,
              g.expires_at, g.created_at, g.updated_at,
              c.full_name AS client_name, c.email AS client_email,
              0 AS item_count
            FROM client_galleries g
            JOIN clients c ON c.id = g.client_id
            WHERE g.id = ?
          `).bind(result.meta.last_row_id).first();
          return json({ success: true, gallery }, 201, origin);
        } catch (error) {
          console.error("Gallery creation failed:", error);
          return json({ error: "Could not create private gallery" }, 500, origin);
        }
      }
      // -------------------------------------------------
      // WEBSITE CONTENT: LIST
      // -------------------------------------------------
      if (url.pathname === "/admin/content" && request.method === "GET") {
        try {
          const result = await env.DB.prepare(`
            SELECT
              id, section, content_key,
              COALESCE(title, content_key) AS title,
              body AS value, body AS description,
              media_id, button_text, button_url,
              is_visible, display_order, updated_at
            FROM website_content
            ORDER BY section COLLATE NOCASE ASC, display_order ASC, content_key ASC
          `).all();
          return json({ content: result.results }, 200, origin);
        } catch (error) {
          console.error("Website content listing failed:", error);
          return json({ error: "Could not retrieve website content" }, 500, origin);
        }
      }
      // -------------------------------------------------
      // WEBSITE CONTENT: CREATE OR UPDATE
      // -------------------------------------------------
      if (url.pathname === "/admin/content" && request.method === "POST") {
        try {
          const body = await request.json();
          const section = typeof body?.section === "string" ? body.section.trim().slice(0, 80) : "";
          const contentKey = typeof body?.content_key === "string" ? body.content_key.trim().slice(0, 80) : "";
          const value = typeof body?.value === "string" ? body.value.slice(0, 5000) : "";
          if (!section || !contentKey) {
            return json({ error: "Both section and content key are required" }, 400, origin);
          }
          await env.DB.prepare(`
            INSERT INTO website_content (section, content_key, body, updated_at)
            VALUES (?, ?, ?, CURRENT_TIMESTAMP)
            ON CONFLICT(content_key) DO UPDATE SET
              section = excluded.section,
              body = excluded.body,
              updated_at = CURRENT_TIMESTAMP
          `).bind(section, contentKey, value).run();
          const content = await env.DB.prepare(`
            SELECT id, section, content_key,
                   COALESCE(title, content_key) AS title,
                   body AS value, body AS description,
                   media_id, button_text, button_url,
                   is_visible, display_order, updated_at
            FROM website_content WHERE content_key = ?
          `).bind(contentKey).first();
          return json({ success: true, content }, 200, origin);
        } catch (error) {
          console.error("Website content save failed:", error);
          return json({ error: "Could not save website content" }, 500, origin);
        }
      }
      // -------------------------------------------------
      // WEBSITE SETTINGS: LIST
      // -------------------------------------------------
      if (url.pathname === "/admin/settings" && request.method === "GET") {
        try {
          const result = await env.DB.prepare(`
            SELECT setting_key AS key, setting_value AS value, updated_at
            FROM website_settings
            ORDER BY setting_key COLLATE NOCASE ASC
          `).all();
          return json({ settings: result.results }, 200, origin);
        } catch (error) {
          console.error("Website settings listing failed:", error);
          return json({ error: "Could not retrieve website settings" }, 500, origin);
        }
      }
      // -------------------------------------------------
      // WEBSITE SETTINGS: CREATE OR UPDATE
      // -------------------------------------------------
      if (url.pathname === "/admin/settings" && request.method === "POST") {
        try {
          const body = await request.json();
          const key = typeof body?.key === "string" ? body.key.trim().slice(0, 100) : "";
          const value = typeof body?.value === "string" ? body.value.slice(0, 1000) : "";
          if (!key) return json({ error: "Setting key is required" }, 400, origin);
          await env.DB.prepare(`
            INSERT INTO website_settings (setting_key, setting_value, updated_at)
            VALUES (?, ?, CURRENT_TIMESTAMP)
            ON CONFLICT(setting_key) DO UPDATE SET
              setting_value = excluded.setting_value,
              updated_at = CURRENT_TIMESTAMP
          `).bind(key, value).run();
          return json({ success: true, setting: { key, value } }, 200, origin);
        } catch (error) {
          console.error("Website setting save failed:", error);
          return json({ error: "Could not save website setting" }, 500, origin);
        }
      }
      // BOOKINGS: LIST
      // -----------------------------------------------
      if (
        url.pathname === "/admin/bookings" &&
        request.method === "GET"
      ) {
        try {
          const result = await env.DB.prepare(`
            SELECT * FROM bookings
            ORDER BY created_at DESC
            LIMIT 200
          `).all();
          return json({
            bookings: result.results
          }, 200, origin);
        } catch (error) {
          console.error("Booking listing failed:", error);
          return json({
            error: "Could not retrieve bookings"
          }, 500, origin);
        }
      }
      // -----------------------------------------------
      // BOOKINGS: UPDATE STATUS AND EMAIL CLIENT
      // -----------------------------------------------
      const bookingMatch = url.pathname.match(
        /^\/admin\/bookings\/([1-9]\d*)$/
      );
      if (bookingMatch) {
        const bookingId = Number(bookingMatch[1]);
        if (request.method === "PATCH") {
          try {
            const body = await request.json();
            const status = body?.status;
            if (!ALLOWED_STATUSES.includes(status)) {
              return json({
                error: "Status must be Pending, Confirmed, or Cancelled"
              }, 400, origin);
            }
            const booking = await env.DB.prepare(`
              SELECT * FROM bookings WHERE id = ?
            `).bind(bookingId).first();
            if (!booking) {
              return json({
                error: "Booking not found"
              }, 404, origin);
            }
            const previousStatus = booking.status;
            await env.DB.prepare(`
              UPDATE bookings SET status = ? WHERE id = ?
            `).bind(status, bookingId).run();
            // Record status history when the history table exists.
            try {
              if (previousStatus !== status) {
                await env.DB.prepare(`
                  INSERT INTO booking_status_history (
                    booking_id,
                    previous_status,
                    new_status,
                    changed_by
                  )
                  VALUES (?, ?, ?, ?)
                `).bind(
                  bookingId,
                  previousStatus,
                  status,
                  ADMIN_EMAIL
                ).run();
              }
            } catch (historyError) {
              console.error(
                "Booking history recording failed:",
                historyError
              );
            }
            if (
              previousStatus !== status &&
              (status === "Confirmed" || status === "Cancelled")
            ) {
              const confirmed = status === "Confirmed";
              const message = confirmed
                ? "Good news! Your booking has been confirmed. We look forward to seeing you."
                : "Unfortunately, your booking has been cancelled. If you have any questions, please reply to this email.";
              const content = `
                <h2>${confirmed
                  ? "Your shoot is confirmed!"
                  : "Your booking has been cancelled"}</h2>
                <p>Hi ${escapeHtml(booking.customer_name)},</p>
                <p>${message}</p>
                <h3>Your booking details</h3>
                <table width="100%" cellspacing="0" cellpadding="0">
                  ${detailRow("Service", booking.service)}
                  ${detailRow("Date", booking.booking_date)}
                  ${detailRow("Time", booking.booking_time)}
                  ${detailRow("Status", status)}
                </table>
              `;
              try {
                await sendBrevoEmail(env, {
                  sender: SENDER,
                  to: [{
                    email: booking.email,
                    name: booking.customer_name
                  }],
                  replyTo: REPLY_TO,
                  subject: confirmed
                    ? "Your x7studio shoot is confirmed!"
                    : "An update about your x7studio booking",
                  textContent:
                    `Hi ${booking.customer_name},\n\n${message}\n\n` +
                    `Service: ${booking.service}\n` +
                    `Date: ${booking.booking_date}\n` +
                    `Time: ${booking.booking_time}\n` +
                    `Status: ${status}\n\nx7studio`,
                  htmlContent: emailLayout(content)
                });
              } catch (emailError) {
                console.error(
                  "Client status email failed:",
                  emailError
                );
              }
            }
            return json({
              success: true,
              booking_id: bookingId,
              status
            }, 200, origin);
          } catch (error) {
            console.error("Status update failed:", error);
            return json({
              error: "Status update failed"
            }, 500, origin);
          }
        }
        // ---------------------------------------------
        // BOOKINGS: DELETE
        // ---------------------------------------------
        if (request.method === "DELETE") {
          try {
            const result = await env.DB.prepare(`
              DELETE FROM bookings WHERE id = ?
            `).bind(bookingId).run();
            if (result.meta.changes === 0) {
              return json({
                error: "Booking not found"
              }, 404, origin);
            }
            return json({
              success: true,
              deleted_booking_id: bookingId
            }, 200, origin);
          } catch (error) {
            console.error("Booking deletion failed:", error);
            return json({
              error: "Booking deletion failed"
            }, 500, origin);
          }
        }
        return json({
          error: "Method not allowed"
        }, 405, origin);
      }
      return json({
        error: "Admin endpoint not found"
      }, 404, origin);
    }
    return json({
      error: "Not found"
    }, 404, origin);
  }
};
