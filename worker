        await env.DB.prepare("CREATE TABLE IF NOT EXISTS unavailable_dates (date TEXT PRIMARY KEY, reason TEXT NOT NULL DEFAULT '', created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)").run();
