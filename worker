              c.full_name AS client_name, c.email AS client_email,
              0 AS item_count
            FROM client_galleries g
            JOIN clients c ON c.id = g.client_id
            WHERE g.id = ?
          `).bind(result.meta.last_row_id).first();
          // Send gallery notifications through Brevo. Gallery creation remains successful if email fails.
          let emailNotifications = { sent: 0, reason: "" };
          if (!env.BREVO_API_KEY) {
            emailNotifications.reason = "BREVO_API_KEY is not configured in the Worker";
          } else {
            const escapeEmail = value => String(value ?? "").replace(/[&<>"']/g, function(ch) {
              return { "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" }[ch];
            });
            const safeTitle = escapeEmail(title);
            const safeName = escapeEmail(client.full_name || "there");
            const safePassword = escapeEmail(password);
            const sendGalleryEmail = async (to, toName, subject, heading, intro) => {
              if (!to || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(to)) throw new Error("Recipient email address is missing or invalid");
              const response = await fetch("https://api.brevo.com/v3/smtp/email", {
                method: "POST",
                headers: { "api-key": env.BREVO_API_KEY, "accept": "application/json", "content-type": "application/json" },
                body: JSON.stringify({
                  sender: { name: SENDER.name, email: SENDER.email },
                  to: [{ email: to, name: toName || to }],
                  replyTo: { email: REPLY_TO.email, name: REPLY_TO.name },
                  subject,
                  htmlContent: '<div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;color:#263844;line-height:1.6"><div style="background:#172a35;padding:22px;color:#fff;font-weight:700;letter-spacing:2px">x7studio</div><div style="padding:24px"><h2>' + heading + '</h2><p>' + intro + '</p><p><strong>Gallery:</strong> ' + safeTitle + '</p><p><strong>Access password:</strong> <span style="font-family:monospace;font-size:18px;background:#f1f5f7;padding:8px 12px;border-radius:5px">' + safePassword + '</span></p><p>Keep this password private. If you need help accessing the gallery, reply to this email.</p><p style="color:#71818b;font-size:12px">X7 Studios</p></div></div>',
                  textContent: heading + "\n\n" + intro + "\nGallery: " + title + "\nAccess password: " + password + "\n\nKeep this password private. X7 Studios"
                })
              });
              if (!response.ok) {
                const detail = await response.text().catch(() => "");
                throw new Error("Brevo returned HTTP " + response.status + (detail ? ": " + detail.slice(0, 200) : ""));
              }
              return response.json();
            };
            const deliveries = await Promise.allSettled([
              sendGalleryEmail(client.email, client.full_name, "Your X7 Studios private gallery is ready", "Your private gallery is ready", "Hello " + safeName + ", your X7 Studios private gallery has been created."),
              sendGalleryEmail(ADMIN_EMAIL, "X7 Studios admin", "Private gallery created: " + title, "A private gallery was created", "A new private gallery has been created for " + safeName + " (" + escapeEmail(client.email) + ").")
            ]);
            emailNotifications.sent = deliveries.filter(x => x.status === "fulfilled").length;
            if (emailNotifications.sent !== 2) {
              emailNotifications.reason = deliveries.filter(x => x.status === "rejected").map(x => x.reason?.message || "Email failed").join("; ");
              console.error("Gallery notification delivery issue:", emailNotifications.reason);
            }
          }
          return json({ success: true, gallery, email_notifications: emailNotifications }, 201, origin);
        } catch (error) {
          console.error("Gallery creation failed:", error);
          return json({ error: "Could not create private gallery" }, 500, origin);
        }
      }
      // PRIVATE GALLERIES: PERMANENT DELETE; original media files remain untouched.
      const galleryDeleteMatch = url.pathname.match(new RegExp("^/admin/galleries/([0-9]+)$"));
      if (galleryDeleteMatch && request.method === "DELETE") {
        try {
          const galleryId = Number(galleryDeleteMatch[1]);
          const existing = await env.DB.prepare("SELECT id FROM client_galleries WHERE id = ?").bind(galleryId).first();
          if (!existing) return json({ error: "Private gallery not found" }, 404, origin);
          await env.DB.batch([
            env.DB.prepare("DELETE FROM gallery_items WHERE gallery_id = ?").bind(galleryId),
            env.DB.prepare("DELETE FROM client_galleries WHERE id = ?").bind(galleryId)
          ]);
          return json({ success: true, message: "Gallery permanently deleted; original media files retained." }, 200, origin);
        } catch (error) {
          console.error("Permanent gallery deletion failed:", error);
          return json({ error: "Could not permanently delete this gallery" }, 500, origin);
        }
      }
      // PRIVATE GALLERY EDITOR API: manage metadata and gallery-only media links.
      const galleryUploadMatch = url.pathname.match(/^\/admin\/galleries\/(\d+)\/upload$/);
      if (galleryUploadMatch && request.method === "POST") {
        try {
          const galleryId = Number(galleryUploadMatch[1]);
          const gallery = await env.DB.prepare("SELECT id FROM client_galleries WHERE id = ?").bind(galleryId).first();
          if (!gallery) return json({ error: "Private gallery not found" }, 404, origin);
          const formData = await request.formData();
          const file = formData.get("file");
          if (!file || typeof file === "string") return json({ error: "Choose an image to upload" }, 400, origin);
          if (!file.type || !ALLOWED_IMAGE_TYPES.includes(file.type)) return json({ error: "Use a JPG, PNG, WebP or AVIF image" }, 400, origin);
          if (!file.size || file.size > MAX_IMAGE_SIZE) return json({ error: "Images must be non-empty and 20 MB or smaller" }, 400, origin);
          const uploaded = await uploadToImageKit(env, file, "private-galleries");
          const mediaId = await saveMediaAsset(env, uploaded, file, file.name);
          const order = await env.DB.prepare("SELECT COALESCE(MAX(display_order),-1)+1 AS n FROM gallery_items WHERE gallery_id=?").bind(galleryId).first();
          await env.DB.prepare("INSERT INTO gallery_items (gallery_id,media_id,display_order,is_downloadable) VALUES (?,?,?,1)").bind(galleryId, mediaId, Number(order?.n || 0)).run();
          return json({ success:true, media_id:mediaId, gallery_id:galleryId, image:{url:uploaded.url,thumbnail_url:uploaded.thumbnailUrl||null,file_name:uploaded.name||file.name} },201,origin);
        } catch (error) {
          console.error("Private gallery image upload failed:", error);
          return json({ error:error.message || "Could not upload photograph to private gallery" },500,origin);
        }
      }
      const gItems = url.pathname.match(/^\/admin\/galleries\/(\d+)\/items$/);
      const gItem = url.pathname.match(/^\/admin\/galleries\/(\d+)\/items\/(\d+)$/);
      const gEdit = url.pathname.match(/^\/admin\/galleries\/(\d+)$/);
      if (gItems) {
        try {
          const gid=Number(gItems[1]), exists=await env.DB.prepare("SELECT id FROM client_galleries WHERE id = ?").bind(gid).first();
          if(!exists)return json({error:"Gallery not found"},404,origin);
          if(request.method==="GET"){
            const r=await env.DB.prepare(`SELECT gi.id AS gallery_item_id,gi.gallery_id,gi.media_id,gi.display_order,gi.is_downloadable,ma.image_url,ma.thumbnail_url,ma.file_name,ma.alt_text,ma.width,ma.height FROM gallery_items gi JOIN media_assets ma ON ma.id=gi.media_id WHERE gi.gallery_id=? ORDER BY gi.display_order,gi.id`).bind(gid).all();
            return json({success:true,items:r.results},200,origin);
          }
          if(request.method==="POST"){
            const b=await request.json(),mid=Number(b?.media_id);
            if(!Number.isSafeInteger(mid)||mid<1)return json({error:"Select a valid photograph"},400,origin);
            const media=await env.DB.prepare("SELECT id FROM media_assets WHERE id=?").bind(mid).first();
            if(!media)return json({error:"Photograph not found in media library"},404,origin);
            const duplicate=await env.DB.prepare("SELECT id FROM gallery_items WHERE gallery_id=? AND media_id=?").bind(gid,mid).first();
            if(duplicate)return json({error:"This photograph is already in the gallery"},409,origin);
            const order=await env.DB.prepare("SELECT COALESCE(MAX(display_order),-1)+1 AS n FROM gallery_items WHERE gallery_id=?").bind(gid).first();
            await env.DB.prepare("INSERT INTO gallery_items (gallery_id,media_id,display_order,is_downloadable) VALUES (?,?,?,?)").bind(gid,mid,order.n,b?.is_downloadable===false?0:1).run();
            return json({success:true},201,origin);
          }
          return json({error:"Method not allowed"},405,origin);
        }catch(error){console.error("Gallery item operation failed:",error);return json({error:"Could not update gallery photographs"},500,origin)}
      }
      if(gItem&&request.method==="PATCH"){
        try{
          const gid=Number(gItem[1]),iid=Number(gItem[2]),b=await request.json();
          const item=await env.DB.prepare("SELECT id FROM gallery_items WHERE id=? AND gallery_id=?").bind(iid,gid).first();
          if(!item)return json({error:"Gallery photograph not found"},404,origin);
          if(typeof b?.is_downloadable!=="boolean")return json({error:"No valid change supplied"},400,origin);
          await env.DB.prepare("UPDATE gallery_items SET is_downloadable=? WHERE id=? AND gallery_id=?").bind(b.is_downloadable?1:0,iid,gid).run();
          return json({success:true},200,origin);
        }catch(error){console.error("Gallery item permission update failed:",error);return json({error:"Could not update download permission"},500,origin)}
      }
      if(gItem&&request.method==="DELETE"){
        try{
          const result=await env.DB.prepare("DELETE FROM gallery_items WHERE id=? AND gallery_id=?").bind(Number(gItem[2]),Number(gItem[1])).run();
          if(!result.meta.changes)return json({error:"Gallery photograph not found"},404,origin);
          return json({success:true,message:"Removed from gallery; ImageKit original retained."},200,origin);
        }catch(error){console.error("Gallery item removal failed:",error);return json({error:"Could not remove photograph"},500,origin)}
      }
      if(gEdit&&request.method==="PATCH"){
        try{
          const gid=Number(gEdit[1]),b=await request.json(),g=await env.DB.prepare("SELECT id,title,description,is_active,expires_at FROM client_galleries WHERE id=?").bind(gid).first();
          if(!g)return json({error:"Gallery not found"},404,origin);
          const title=typeof b?.title==="string"?b.title.trim().slice(0,200):g.title;
          const description=typeof b?.description==="string"?b.description.trim().slice(0,2000):(g.description||"");
          const expiry=typeof b?.expires_at==="string"?b.expires_at.trim():(g.expires_at||"");
          if(!title)return json({error:"Gallery title is required"},400,origin);
          if(expiry&&Number.isNaN(Date.parse(expiry)))return json({error:"Gallery expiry date is invalid"},400,origin);
          await env.DB.prepare("UPDATE client_galleries SET title=?,description=?,expires_at=?,is_active=?,updated_at=CURRENT_TIMESTAMP WHERE id=?").bind(title,description||null,expiry||null,b?.is_active===false?0:b?.is_active===true?1:g.is_active,gid).run();
          return json({success:true},200,origin);
        }catch(error){console.error("Gallery details update failed:",error);return json({error:"Could not save gallery details"},500,origin)}
      }
      // -------------------------------------------------
      // WEBSITE CONTENT: LIST
      // -------------------------------------------------
      if (url.pathname === "/admin/content" && request.method === "GET") {
        try {
          const result = await env.DB.prepare(`
            SELECT
              id, section, content_key,
              COALESCE(title, content_key) AS title,
              body AS value, body AS description,
              media_id, button_text, button_url,
              is_visible, display_order, updated_at
            FROM website_content
            ORDER BY section COLLATE NOCASE ASC, display_order ASC, content_key ASC
          `).all();
          return json({ content: result.results }, 200, origin);
        } catch (error) {
          console.error("Website content listing failed:", error);
          return json({ error: "Could not retrieve website content" }, 500, origin);
        }
      }
      // -------------------------------------------------
      // WEBSITE CONTENT: CREATE OR UPDATE
      // -------------------------------------------------
      if (url.pathname === "/admin/content" && request.method === "POST") {
        try {
          const body = await request.json();
          const section = typeof body?.section === "string" ? body.section.trim().slice(0, 80) : "";
          const contentKey = typeof body?.content_key === "string" ? body.content_key.trim().slice(0, 80) : "";
          const value = typeof body?.value === "string" ? body.value.slice(0, 5000) : "";
          if (!section || !contentKey) {
            return json({ error: "Both section and content key are required" }, 400, origin);
          }
          await env.DB.prepare(`
            INSERT INTO website_content (section, content_key, body, updated_at)
            VALUES (?, ?, ?, CURRENT_TIMESTAMP)
            ON CONFLICT(content_key) DO UPDATE SET
              section = excluded.section,
              body = excluded.body,
              updated_at = CURRENT_TIMESTAMP
          `).bind(section, contentKey, value).run();
          const content = await env.DB.prepare(`
            SELECT id, section, content_key,
                   COALESCE(title, content_key) AS title,
                   body AS value, body AS description,
                   media_id, button_text, button_url,
                   is_visible, display_order, updated_at
            FROM website_content WHERE content_key = ?
          `).bind(contentKey).first();
          return json({ success: true, content }, 200, origin);
        } catch (error) {
          console.error("Website content save failed:", error);
          return json({ error: "Could not save website content" }, 500, origin);
        }
      }
      // -------------------------------------------------
      // WEBSITE SETTINGS: LIST
      // -------------------------------------------------
      if (url.pathname === "/admin/settings" && request.method === "GET") {
        try {
          const result = await env.DB.prepare(`
            SELECT setting_key AS key, setting_value AS value, updated_at
            FROM website_settings
            ORDER BY setting_key COLLATE NOCASE ASC
          `).all();
          return json({ settings: result.results }, 200, origin);
        } catch (error) {
          console.error("Website settings listing failed:", error);
          return json({ error: "Could not retrieve website settings" }, 500, origin);
        }
      }
      // -------------------------------------------------
      // WEBSITE SETTINGS: CREATE OR UPDATE
      // -------------------------------------------------
      if (url.pathname === "/admin/settings" && request.method === "POST") {
        try {
          const body = await request.json();
          const key = typeof body?.key === "string" ? body.key.trim().slice(0, 100) : "";
          const value = typeof body?.value === "string" ? body.value.slice(0, 1000) : "";
          if (!key) return json({ error: "Setting key is required" }, 400, origin);
          await env.DB.prepare(`
            INSERT INTO website_settings (setting_key, setting_value, updated_at)
            VALUES (?, ?, CURRENT_TIMESTAMP)
            ON CONFLICT(setting_key) DO UPDATE SET
              setting_value = excluded.setting_value,
              updated_at = CURRENT_TIMESTAMP
          `).bind(key, value).run();
          return json({ success: true, setting: { key, value } }, 200, origin);
        } catch (error) {
          console.error("Website setting save failed:", error);
          return json({ error: "Could not save website setting" }, 500, origin);
        }
      }
      // BOOKINGS: LIST
      // -----------------------------------------------
      if (
        url.pathname === "/admin/bookings" &&
        request.method === "GET"
      ) {
        try {
          const result = await env.DB.prepare(`
            SELECT * FROM bookings
            ORDER BY created_at DESC
            LIMIT 200
          `).all();
          return json({
            bookings: result.results
          }, 200, origin);
        } catch (error) {
          console.error("Booking listing failed:", error);
          return json({
            error: "Could not retrieve bookings"
          }, 500, origin);
        }
      }
      // -----------------------------------------------
      // BOOKINGS: UPDATE STATUS AND EMAIL CLIENT
      // -----------------------------------------------
      const bookingMatch = url.pathname.match(
        /^\/admin\/bookings\/([1-9]\d*)$/
      );
      if (bookingMatch) {
        const bookingId = Number(bookingMatch[1]);
        if (request.method === "PATCH") {
          try {
            const body = await request.json();
            const status = body?.status;
            if (!ALLOWED_STATUSES.includes(status)) {
              return json({
                error: "Status must be Pending, Confirmed, or Cancelled"
              }, 400, origin);
            }
            const booking = await env.DB.prepare(`
              SELECT * FROM bookings WHERE id = ?
            `).bind(bookingId).first();
            if (!booking) {
              return json({
                error: "Booking not found"
              }, 404, origin);
            }
            const previousStatus = booking.status;
            await env.DB.prepare(`
              UPDATE bookings SET status = ? WHERE id = ?
            `).bind(status, bookingId).run();
            // Record status history when the history table exists.
            try {
              if (previousStatus !== status) {
                await env.DB.prepare(`
                  INSERT INTO booking_status_history (
                    booking_id,
                    previous_status,
                    new_status,
                    changed_by
                  )
                  VALUES (?, ?, ?, ?)
                `).bind(
                  bookingId,
                  previousStatus,
                  status,
                  ADMIN_EMAIL
                ).run();
              }
            } catch (historyError) {
              console.error(
                "Booking history recording failed:",
                historyError
              );
            }
            if (
              previousStatus !== status &&
              (status === "Confirmed" || status === "Cancelled")
            ) {
              const confirmed = status === "Confirmed";
              const message = confirmed
                ? "Good news! Your booking has been confirmed. We look forward to seeing you."
                : "Unfortunately, your booking has been cancelled. If you have any questions, please reply to this email.";
              const content = `
                <h2>${confirmed
                  ? "Your shoot is confirmed!"
                  : "Your booking has been cancelled"}</h2>
                <p>Hi ${escapeHtml(booking.customer_name)},</p>
                <p>${message}</p>
                <h3>Your booking details</h3>
                <table width="100%" cellspacing="0" cellpadding="0">
                  ${detailRow("Service", booking.service)}
                  ${detailRow("Date", booking.booking_date)}
                  ${detailRow("Time", booking.booking_time)}
                  ${detailRow("Status", status)}
                </table>
              `;
              try {
                await sendBrevoEmail(env, {
                  sender: SENDER,
                  to: [{
                    email: booking.email,
                    name: booking.customer_name
                  }],
                  replyTo: REPLY_TO,
                  subject: confirmed
                    ? "Your x7studio shoot is confirmed!"
                    : "An update about your x7studio booking",
                  textContent:
                    `Hi ${booking.customer_name},\n\n${message}\n\n` +
                    `Service: ${booking.service}\n` +
                    `Date: ${booking.booking_date}\n` +
                    `Time: ${booking.booking_time}\n` +
                    `Status: ${status}\n\nx7studio`,
                  htmlContent: emailLayout(content)
                });
              } catch (emailError) {
                console.error(
                  "Client status email failed:",
                  emailError
                );
              }
            }
            return json({
              success: true,
              booking_id: bookingId,
              status
            }, 200, origin);
          } catch (error) {
            console.error("Status update failed:", error);
            return json({
              error: "Status update failed"
            }, 500, origin);
          }
        }
        // ---------------------------------------------
        // BOOKINGS: DELETE
        // ---------------------------------------------
        if (request.method === "DELETE") {
          try {
            const result = await env.DB.prepare(`
              DELETE FROM bookings WHERE id = ?
            `).bind(bookingId).run();
            if (result.meta.changes === 0) {
              return json({
                error: "Booking not found"
              }, 404, origin);
            }
            return json({
              success: true,
              deleted_booking_id: bookingId
            }, 200, origin);
          } catch (error) {
            console.error("Booking deletion failed:", error);
            return json({
              error: "Booking deletion failed"
            }, 500, origin);
          }
        }
        return json({
          error: "Method not allowed"
        }, 405, origin);
      }
      return json({
        error: "Admin endpoint not found"
      }, 404, origin);
    }
    return json({
      error: "Not found"
    }, 404, origin);
  }
};
